# Long random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
# Optional: derived from MOODLE_DB_JWT when unset. Set it only to rotate sessions independently.
SESSION_SECRET=
# Supabase API URL (server-side only, never NEXT_PUBLIC_).
SUPABASE_URL=https://your-supabase-host
# Public anon key, sent as the `apikey` header so the API gateway accepts the request.
SUPABASE_ANON_KEY=your-anon-key
# Long-lived JWT with claim role=moodle_app (see scripts/make_moodle_jwt.py), sent as Bearer.
MOODLE_DB_JWT=your-moodle-app-jwt
# Legacy fallback, only used when MOODLE_DB_JWT is not set (then sent as apikey and Bearer).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Moodle site used to verify logins (must be https). Optional: defaults to https://evirtual.utm.edu.ec
MOODLE_URL=https://evirtual.utm.edu.ec
# Moodle username of the owner: registers without an invite code the first time and becomes admin.
ADMIN_MOODLE_USERNAME=your-moodle-username
# Existing ntfy topic of the owner, kept when the admin account is created. Optional: random if unset.
ADMIN_NTFY_TOPIC=your-existing-ntfy-topic
# ntfy server used for the "test notification" button and the subscribe link. Optional (https only).
# NTFY_SERVER=https://ntfy.sh
