# Supabase (self-hosted, shared). Recommended setup: a dedicated Postgres role
# `moodle_app` limited to the moodle_* tables, reached with a JWT carrying role=moodle_app.
SUPABASE_URL=https://your-supabase-host
# Public anon key of the instance (sent as the `apikey` header so the gateway accepts the request)
SUPABASE_ANON_KEY=your-anon-key
# Long-lived JWT with role=moodle_app. Generate it with:
#   JWT_SECRET=<instance jwt secret> python scripts/make_moodle_jwt.py
MOODLE_DB_JWT=

# LEGACY fallbacks, used only when MOODLE_DB_JWT is empty. Do NOT use the service-role
# key of a shared instance.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Optional: Moodle web-service token. Normally read from the moodle_credentials table
# (written by the web app); this is only the fallback.
MOODLE_TOKEN=
MOODLE_URL=https://evirtual.utm.edu.ec
# Legacy cookie fallback, used only when no token is available
MOODLE_SESSION=
