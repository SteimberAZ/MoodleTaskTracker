# Worker on the VPS (worker.py). Copy to .env next to worker.py and fill in the values.
# Never commit .env; it holds the database JWT.

# --- Database (required) -----------------------------------------------------------------------
# Self-hosted Supabase shared with other apps: the worker only touches the moodle_* tables, through
# a dedicated Postgres role `moodle_app` reached with a JWT carrying role=moodle_app.
SUPABASE_URL=https://your-supabase-host
# Public anon key of the instance (sent as the `apikey` header so the gateway accepts the request).
SUPABASE_ANON_KEY=your-anon-key
# Long-lived JWT with role=moodle_app. Generate it with:
#   JWT_SECRET=<instance jwt secret> python scripts/make_moodle_jwt.py --years 5
MOODLE_DB_JWT=

# --- Moodle ------------------------------------------------------------------------------------
# Moodle site. Each user's token is read from the database (written by the web app at login).
MOODLE_URL=https://evirtual.utm.edu.ec

# --- Web Push (required for notifications) -----------------------------------------------------
# Required: contact sent to the push services (mailto: or https:). Without it some services reject pushes.
VAPID_SUBJECT=mailto:you@example.com
# PEM written by `python scripts/generate_vapid.py` (relative to this folder). Back it up off the box.
VAPID_PRIVATE_KEY_FILE=./vapid_private.pem
# Must equal NEXT_PUBLIC_VAPID_PUBLIC_KEY on Vercel; on a mismatch the worker disables Web Push loudly.
VAPID_PUBLIC_KEY_EXPECTED=

# --- ntfy (optional second channel) ------------------------------------------------------------
# ntfy server for users who keep ntfy on in /cuenta (https). Defaults to https://ntfy.sh.
NTFY_SERVER=https://ntfy.sh
# Optional, no default: owner topic for the built-in class schedule when no admin user exists.
NTFY_TOPIC=

# --- Links and monitoring (optional) -----------------------------------------------------------
# Public URL of the web app, no trailing slash (e.g. https://your-app.vercel.app): ntfy taps open it.
WEB_APP_URL=
# Dead-man switch: URL pinged at the end of every tick (e.g. a healthchecks.io check); /fail on errors.
HEALTHCHECK_URL=
# Set to 1 to make the worker exit at startup when the database or Web Push is not configured
# (pm2 then shows it as errored). By default it keeps running degraded and reports it in /admin.
WORKER_STRICT=
